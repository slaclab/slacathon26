# SLACATHON'26 configuration
# Copy to .env or export as env vars

# API Keys (required for real use)
SLACATHON_API_KEYS=your_strong_key_1,your_strong_key_2

# Task selection
SLACATHON_ACTIVE_TASK=flat_beam

# Server
SLACATHON_HOST=127.0.0.1
SLACATHON_PORT=8888
SLACATHON_WORKERS=1
SLACATHON_TIMEOUT=300
SLACATHON_LOG_LEVEL=info

# Files
SLACATHON_LEADERBOARD_FILE=data/leaderboard.json
SLACATHON_DB_FILE=data/slacathon.db

# Limits
SLACATHON_MAX_QUERIES_PER_USER=10
SLACATHON_MAX_VALIDATIONS_PER_USER=10000
SLACATHON_LEADERBOARD_SIZE=15

# Failure score fallback
SLACATHON_FAILURE_SCORE=1.0e10

# FastAPI
SLACATHON_ROOT_PATH=/slacathon26
